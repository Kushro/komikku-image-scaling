CREATE TABLE scanlator_priorities(
    manga_id INTEGER NOT NULL,
    scanlator TEXT NOT NULL,
    rank INTEGER NOT NULL,
    PRIMARY KEY(manga_id, scanlator),
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE
);

CREATE INDEX idx_scanlator_priorities_manga_id ON scanlator_priorities(manga_id);

insert:
INSERT INTO scanlator_priorities(manga_id, scanlator, rank)
VALUES (:mangaId, :scanlator, :rank);

removeAllByMangaId:
DELETE FROM scanlator_priorities
WHERE manga_id = :mangaId;

getScanlatorPrioritiesByMangaId:
SELECT scanlator
FROM scanlator_priorities
WHERE manga_id = :mangaId
ORDER BY rank ASC;
